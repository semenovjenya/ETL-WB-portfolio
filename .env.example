POSTGRES_DB=wb_docs
POSTGRES_USER=wb_user
POSTGRES_PASSWORD=wb_pass
POSTGRES_PORT=55433

DB_HOST=localhost
DB_PORT=55433
DB_NAME=wb_docs
DB_USER=wb_user
DB_PASSWORD=wb_pass

PG_DSN=postgresql://wb_user:wb_pass@localhost:55433/wb_docs
DATABASE_URL=postgresql://wb_user:wb_pass@localhost:55433/wb_docs

# Если другой проект работает в Docker и подключён к сети wb-shared-network:
# DB_HOST=wb-shared-db
# DB_PORT=5432

# OpenAI (required for embeddings and RAG answers)
OPENAI_API_KEY=sk-your-key-here

# Optional dedicated key for wb_price_ai_analysis SEO keyword generation
SEO_KEYWORD_OPENAI_API_KEY=sk-your-seo-key-here
# Optional dedicated base URL for wb_price_ai_analysis SEO keyword generation
# SEO_KEYWORD_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional dedicated key/base URL for wb_price_ai_analysis relevance scoring
# WB_PRICE_AI_RELEVANCE_OPENAI_API_KEY=sk-your-relevance-key-here
# WB_PRICE_AI_RELEVANCE_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional dedicated key/base URL for wb_price_ai_analysis vision scoring
# WB_PRICE_AI_VISION_OPENAI_API_KEY=sk-your-vision-key-here
# WB_PRICE_AI_VISION_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional dedicated model for wb_price_ai_analysis SEO keyword generation
# WB_PRICE_AI_SEO_MODEL=gpt-4o-mini
# Optional host-runner settings for wb_price_ai_analysis competitor stage
# WB_PRICE_AI_HOST_RUNNER_ENABLED=true
# WB_PRICE_AI_HOST_RUNNER_POLL_INTERVAL_SEC=5
# WB_PRICE_AI_HOST_RUNNER_TIMEOUT_SEC=3600
# WB_PRICE_AI_HOST_RUNNER_STALE_SEC=1800
# WB_PRICE_AI_HOST_WORKER_ID=my-host-worker
# Optional vision settings
# WB_PRICE_AI_VISION_MODEL=gpt-4o-mini
# WB_PRICE_AI_VISION_PROMPT_VERSION=v1
# WB_PRICE_AI_VISION_LIMIT_PER_SKU=3

# WB API key
WB_API_KEY=your-wb-api-key-here

# Optional: embedding model and dimensions (default: text-embedding-3-small, 1536)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# Optional: LLM for RAG answers (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
